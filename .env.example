# PickUp — Supabase configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Values come from Supabase Dashboard -> Project Settings -> API.
#
# The app reads these at build time via `process.env`. If they are missing,
# the app fails gracefully with a clear on-screen message (see lib/supabase.ts).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
